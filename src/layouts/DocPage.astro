---
import { translator, localeFor, localizedPath } from "@/i18n";
const t = translator(Astro.url.pathname);
const locale = localeFor(Astro.url.pathname);
const local = (path: string) => localizedPath(path, locale);
import Layout from "@/layouts/Layout.astro";
import { basics } from "@cv";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const { name } = basics;
---

<Layout title={`${title} · ${name}`} description={description}>
  <main class="doc">
    <p class="back">
      <a href={local("/")}>{t("Home")}</a>
    </p>
    <article class="doc-page">
      <h1>{title}</h1>
      <slot />
    </article>
    <nav>
      <a href={local("/")}>{t("Home")}</a>
      <a href={local("/about")}>{t("About")}</a>
      <a href={local("/contact")}>{t("Contact")}</a>
      <a href={local("/privacy")}>{t("Privacy")}</a>
      <a href="/llms.txt">llms.txt</a>
    </nav>
  </main>
</Layout>

<style>
  .doc {
    width: min(42rem, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 3.75rem 0 5.5rem;
  }

  .back {
    margin: 0 0 2rem;
    font-size: 0.95rem;
    color: rgb(var(--color-text-muted));
  }

  h1 {
    font-weight: 500;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .doc-page :global(h2) {
    font-style: italic;
    font-weight: 400;
    font-size: 1.45rem;
    margin: 2rem 0 0.7rem;
  }

  .doc-page :global(p) {
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .doc-page :global(a),
  .back a,
  nav a {
    color: rgb(var(--color-text-base));
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .doc-page :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    color: rgb(var(--color-text-muted));
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(var(--color-rule), 0.14);
    font-size: 0.88rem;
  }
</style>
