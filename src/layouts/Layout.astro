---
import { basics } from "@cv";
import "../styles/site.css";
import ThemeSwitch from "@/components/ThemeSwitch.astro";
import KeyboardManager from "../components/KeyboardManager.astro";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = basics.summary, noindex = false } = Astro.props;

const { summary } = basics;
const siteUrl = import.meta.env.SITE || "https://rumicalles.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Preload favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="preload"
      href="/fonts/newsreader-regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={new URL(siteUrl).hostname} />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={summary} />
    <meta property="twitter:image" content={`${siteUrl}/og-image.png`} />

    {/* Canonical URL */}
    <link rel="canonical" href={siteUrl + Astro.url.pathname} />

    {/* JSON-LD Structured Data for Person */}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: basics.name,
        url: siteUrl,
        image: `${siteUrl}${basics.image.startsWith("/") ? basics.image : "/" + basics.image}`,
        jobTitle: basics.label,
        description: basics.summary,
        address: {
          "@type": "PostalAddress",
          addressLocality: basics.location.city,
          addressRegion: basics.location.region,
          postalCode: basics.location.postalCode,
          addressCountry: basics.location.countryCode,
        },
        email: basics.email,
        telephone: basics.phone,
        sameAs: basics.profiles.map((profile) => profile.url),
        knowsAbout: [
          "Artificial Intelligence",
          "Machine Learning",
          "Natural Language Processing",
          "Data Science",
          "Python",
          "PyTorch",
          "TensorFlow",
          "Hugging Face",
          "AI Ethics",
          "Mathematica",
          "Software Engineering",
          "Docker",
        ],
      })}
    />

    <script is:inline>
      try {
        if (localStorage.getItem("theme") === "dark")
          document.documentElement.classList.add("dark");
      } catch {
        /* Theme storage is optional. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header page-width">
      <a class="wordmark" href="/" aria-label="Rumi Calles home"
        >Rumi Calles<span>.</span></a
      >
      <nav aria-label="Primary navigation">
        <a href="/#projects">Work</a>
        <a href="/#publications">Writing</a>
        <a
          href="/about"
          aria-current={Astro.url.pathname.startsWith("/about")
            ? "page"
            : undefined}>About</a
        >
        <a
          href="/cv"
          aria-current={Astro.url.pathname.startsWith("/cv")
            ? "page"
            : undefined}>CV</a
        >
        <a class="nav-contact" href={`mailto:${basics.email}`}
          >Get in touch <span aria-hidden="true">↗</span></a
        >
        <ThemeSwitch />
      </nav>
    </header>
    <slot />
    <footer class="site-footer page-width">
      <div>
        <a class="wordmark" href="/">Rumi Calles<span>.</span></a><p>
          Research engineering &amp; classical thought.
        </p>
      </div>
      <nav aria-label="Footer navigation">
        {
          basics.profiles.map(({ network, url }) => (
            <a href={url} target="_blank" rel="noopener noreferrer">
              {network} ↗
            </a>
          ))
        }
        <a href="/contact">Contact</a><a href="/privacy">Privacy</a>
        <button
          id="open-commands"
          type="button"
          aria-label="Open command palette">⌘ K</button
        >
      </nav>
      <p class="copyright">© {new Date().getFullYear()} {basics.name}</p>
    </footer>
    <KeyboardManager />
  </body>
</html>
