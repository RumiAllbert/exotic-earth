---
import { translator, localeFor, localizedPath } from "@/i18n";
const t = translator(Astro.url.pathname);
const locale = localeFor(Astro.url.pathname);
const local = (path: string) => localizedPath(path, locale);
import { hiringDraft } from '@/lib/hiring-draft';
const sections = ['About', 'Experience', 'Publications', 'Skills', 'Education', 'Projects', 'Contact'];
const commands = [
  ...sections.map(title => ({ title: t(title), group: t("Navigate"), url: `${local("/")}#${title.toLowerCase()}` })),
  { title: t("I'm hiring"), group: t("Email draft"), url: hiringDraft },
];
---
<dialog id="command-palette" aria-label={t("Command palette")} class="no-print">
  <header>
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
    <input id="command-search" type="search" placeholder={t("Jump to a section…")} aria-label={t("Search commands")} autocomplete="off" />
    <button id="close-palette" aria-label={t("Close command palette")} title="Esc"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
  </header>
  <ul id="command-results">
    {commands.map(({ title, group, url }) => <li><a href={url} target={url.startsWith('https:') ? '_blank' : undefined} rel={url.startsWith('https:') ? 'noopener noreferrer' : undefined}><span>{title}</span><small>{group}</small></a></li>)}
  </ul>
  <p id="command-empty" hidden>{t("No matches. Try a section or hiring.")}</p>
  <footer>{t("↑ ↓ browse · Enter open · Esc close")}</footer>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#command-palette')!;
  const search = document.querySelector<HTMLInputElement>('#command-search')!;
  const items = Array.from(dialog.querySelectorAll<HTMLLIElement>('li'));
  const empty = document.querySelector<HTMLElement>('#command-empty')!;
  const filter = () => {
    const query = search.value.toLocaleLowerCase().trim();
    items.forEach(item => { item.hidden = !item.textContent!.toLocaleLowerCase().includes(query); });
    empty.hidden = items.some(item => !item.hidden);
  };
  const open = () => { search.value = ''; filter(); dialog.showModal(); search.focus(); };
  document.querySelectorAll('#nav-cmdk').forEach(button => button.addEventListener('click', open));
  document.querySelector('#close-palette')!.addEventListener('click', () => dialog.close());
  document.addEventListener('keydown', event => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      dialog.open ? dialog.close() : open();
    }
  });
  search.addEventListener('input', filter);
  dialog.addEventListener('click', event => {
    if ((event.target as HTMLElement).closest('a') || event.target === dialog) dialog.close();
  });
  dialog.addEventListener('keydown', event => {
    const links = items.filter(item => !item.hidden).map(item => item.querySelector('a')!);
    if (event.key === 'Enter' && event.target === search) { event.preventDefault(); links[0]?.click(); }
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      const index = links.indexOf(document.activeElement as HTMLAnchorElement);
      const next = event.key === 'ArrowDown' ? index + 1 : (index < 0 ? links.length - 1 : index - 1);
      links[(next + links.length) % links.length]?.focus();
    }
  });
</script>
<style>
  dialog { margin: 10vh auto; padding: 0; width: min(32rem, calc(100% - 2rem)); max-height: 80vh; max-height: 80dvh; color: rgb(var(--color-text-base)); background: rgba(var(--color-fill), .96); border: 1px solid rgba(var(--color-rule), .14); border-radius: 1.25rem; box-shadow: 0 24px 80px #0003, inset 0 1px 0 #ffffff14; -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px); }
  dialog::backdrop { background: #0003; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  header { display: flex; align-items: center; gap: .75rem; padding: .6rem .75rem .6rem 1.1rem; border-bottom: 1px solid rgba(var(--color-rule), .12); }
  header:focus-within { box-shadow: inset 0 -2px rgba(var(--color-rule), .24); }
  .search-icon { flex-shrink: 0; color: rgb(var(--color-text-muted)); }
  input { min-width: 0; flex: 1; padding: .5rem 0; background: transparent; color: inherit; border: 0; font: inherit; font-size: 1rem; line-height: 1.5; }
  input:focus-visible { outline: none; }
  input::placeholder { color: rgb(var(--color-text-muted)); opacity: .8; }
  input::-webkit-search-cancel-button { -webkit-appearance: none; }
  button { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex-shrink: 0; cursor: pointer; color: rgb(var(--color-text-muted)); background: transparent; border: 0; border-radius: 50%; }
  button:hover { color: rgb(var(--color-text-base)); background: rgba(var(--color-rule), .06); }
  ul { margin: 0; padding: .4rem; max-height: 52vh; max-height: 52dvh; overflow-y: auto; overscroll-behavior: contain; list-style: none; }
  li[hidden], p[hidden] { display: none; }
  a { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 44px; padding: .55rem .75rem; border-radius: .7rem; font-size: .95rem; line-height: 1.35; }
  a span { min-width: 0; overflow-wrap: anywhere; }
  a:hover, a:focus-visible { background: rgba(var(--color-rule), .07); }
  a:focus-visible, button:focus-visible { outline-offset: -2px; }
  small { max-width: 42%; font-size: .72rem; text-align: right; color: rgb(var(--color-text-muted)); opacity: .8; }
  footer, #command-empty { padding: .75rem 1.1rem; font-size: .72rem; line-height: 1.5; color: rgb(var(--color-text-muted)); }
  footer { border-top: 1px solid rgba(var(--color-rule), .1); }
  @supports not (backdrop-filter: blur(1px)) { dialog { background: rgb(var(--color-fill)); } }
  @media(max-width: 480px) { dialog { margin-top: 5vh; } header { gap: .5rem; padding-left: .9rem; } footer { font-size: .68rem; } }
</style>
