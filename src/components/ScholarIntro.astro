<script is:inline>
(() => {
  const intro = document.getElementById('scholar-intro');
  const localPreview = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);
  const key = 'portfolio-intro-last-shown';
  const day = 24 * 60 * 60 * 1000;
  const now = Date.now();
  if (!intro || (!localPreview && location.hash) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  try {
    const last = Number(localStorage.getItem(key));
    if (!localPreview && last > 0 && now - last < day) return;
    if (!localPreview) localStorage.setItem(key, String(now));
  } catch { if (!localPreview) return; }
  intro.hidden = false;
  let timer;
  const finish = () => {
    clearTimeout(timer);
    intro.hidden = true;
    window.removeEventListener('pointerdown', finish);
    window.removeEventListener('click', finish);
    window.removeEventListener('wheel', finish);
    window.removeEventListener('touchstart', finish);
    window.removeEventListener('keydown', finish);
  };
  window.addEventListener('pointerdown', finish);
  window.addEventListener('click', finish);
  window.addEventListener('wheel', finish, { passive: true });
  window.addEventListener('touchstart', finish, { passive: true });
  window.addEventListener('keydown', finish);
  timer = setTimeout(finish, 4400);
})();
</script>
<style>
#scholar-intro{position:fixed;inset:0;z-index:100;background:rgb(var(--color-fill));color:rgb(var(--color-text-base));display:grid;place-items:center;pointer-events:auto;animation:curtain .95s 3.4s both}
#scholar-intro[hidden]{display:none}
.drawing{width:min(820px,100vw,94svh);pointer-events:auto;animation:dissolve .95s 3.4s both}
svg{display:block;width:100%;overflow:visible}
.ink,.tick,.star path{fill:none;stroke:currentColor;vector-effect:non-scaling-stroke}
.ink{stroke-dasharray:1;stroke-dashoffset:1;animation:etch 1.1s cubic-bezier(.3,0,.2,1) both}
.fine{stroke-width:.8;opacity:.62}.orbit{stroke-width:.7;opacity:.34}.geometry{stroke-width:1;opacity:.58}.ghost{stroke-width:.5;opacity:.09}
.outer>circle:first-child{stroke-width:1.3;opacity:.85}
.outer>circle:nth-child(2){opacity:.28;animation-delay:.12s}
.outer>circle:nth-child(3){opacity:.55;animation-delay:.24s}
.tick{stroke-width:.7;animation:appear .35s calc(.45s + var(--d)) both;opacity:.55}
.star{color:#a86d59;animation:star-arrive .4s var(--d) both}
.star circle{fill:rgb(var(--color-fill));stroke:currentColor;stroke-width:1.2}.star path{stroke-width:.75}
.point{display:none}.center>circle{opacity:.14;stroke-dasharray:.002 .024;animation:none;stroke-dashoffset:0}
.outer,.orbits{transform-origin:400px 340px}.outer{animation:turn 1.8s cubic-bezier(.2,.6,.2,1) both}.orbits{animation:counterturn 2.4s cubic-bezier(.2,.6,.2,1) both}
.construction .ink{animation-delay:.7s;animation-duration:1.15s}.orbits .ink{animation-delay:1s;animation-duration:1.15s}.orbits .ink:nth-child(2){animation-delay:1.15s}.orbits .ink:nth-child(3){animation-delay:1.3s}.harmonic .ink{animation-delay:1.5s;animation-duration:.8s}
.center{animation:appear .85s 1.8s both}
.generated-seal{filter:drop-shadow(0 1px 1px rgb(30 22 15 / .13));animation:seal-arrive .85s 1.8s both;transform-origin:400px 340px}
:global(html.dark) .generated-seal{filter:invert(.88) sepia(.2) drop-shadow(0 1px 1px rgb(0 0 0 / .3))}
@keyframes etch{to{stroke-dashoffset:0}}
@keyframes appear{from{opacity:0}to{opacity:1}}
@keyframes star-arrive{from{opacity:0}60%{opacity:1}to{opacity:.85}}
@keyframes seal-arrive{from{opacity:0;transform:scale(.94)}to{opacity:1;transform:scale(1)}}
@keyframes turn{from{transform:rotate(-5deg)}to{transform:rotate(0)}}
@keyframes counterturn{from{transform:rotate(9deg) scale(.98)}to{transform:rotate(0) scale(1)}}
@keyframes dissolve{to{opacity:0;filter:blur(14px);transform:scale(1.035)}}
@keyframes curtain{to{background:transparent;visibility:hidden}}
@media(prefers-reduced-motion:reduce){#scholar-intro{display:none!important}}
@media print{#scholar-intro{display:none!important}}

/* Faint far arcs and lit near arcs make an armillary sphere around the seal. */
.starfield{fill:currentColor;opacity:.35}.starfield circle{animation:appear .8s var(--star-delay) both}
.orbit{stroke-width:.65;opacity:.18}.near-orbit{stroke:url(#celestial-metal);stroke-width:1.7;opacity:.85;animation-delay:var(--orbit-delay);animation-duration:1.2s;filter:drop-shadow(0 2px 1px rgb(30 22 15 / .16))}
.near-orbits{transform-origin:400px 340px;animation:counterturn 2.4s cubic-bezier(.2,.6,.2,1) both}
.construction .geometry{opacity:.24}.outer>circle:first-child{stroke:url(#celestial-metal);stroke-width:1.6;opacity:.85}
.star .star-aura{fill:#c9ab75;fill-opacity:.1;stroke:none}.star .star-core{fill:url(#celestial-star);stroke:#ac8751;stroke-width:.45}.star path{stroke-width:.65;opacity:.6}
:global(html.dark) .starfield{opacity:.55}
:global(html.dark) .near-orbit{filter:drop-shadow(0 1px 3px rgb(198 169 113 / .13))}
</style>
