---
import { SITE_URL } from '@/lib/site-content';
interface Props { text: string }
const { text } = Astro.props;
const parts = text.split(/(https:\/\/[^\s<>]+|[\w.+-]+@[\w.-]+\.[a-z]{2,}|\+\d[\d ()-]{8,}\d)/gi);
---
{parts.map((part, index) => index % 2
  ? <a href={part.startsWith(`${SITE_URL}/`) ? part.slice(SITE_URL.length) : part.startsWith('https://') ? part : part.includes('@') ? `mailto:${part}` : `tel:${part.replace(/[^+\d]/g, '')}`}>{part}</a>
  : part)}
