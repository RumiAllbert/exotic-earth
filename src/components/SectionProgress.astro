---
import { translator } from "@/i18n";
const t = translator(Astro.url.pathname);
const sections = ['About', 'Experience', 'Publications', 'Skills', 'Education', 'Projects'];
---

<nav class="section-progress no-print" aria-label={t("Page progress")}>
  <div class="rail" aria-hidden="true"><span></span></div>
  {sections.map(title => <a href={`#${title.toLowerCase()}`}>{t(title)}</a>)}
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('.section-progress');
  if (nav) {
    const links = Array.from(nav.querySelectorAll('a'));
    const update = () => {
      const distance = document.documentElement.scrollHeight - innerHeight;
      nav.style.setProperty('--progress', String(distance > 0 ? Math.min(1, Math.max(0, scrollY / distance)) : 1));
      let current = links[0];
      for (const link of links) {
        if (document.querySelector(link.hash)!.getBoundingClientRect().top <= innerHeight * 0.35) current = link;
      }
      links.forEach(link => link === current ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current'));
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    new ResizeObserver(update).observe(document.body);
    update();
  }
</script>

<style>
  .section-progress { position: fixed; left: max(1rem, calc((100vw - 75rem) / 2)); top: 42%; display: grid; gap: 0.7rem; padding-left: 1rem; font-size: 0.8rem; color: rgb(var(--color-text-muted)); }
  a[aria-current], a:hover { color: rgb(var(--color-text-base)); text-decoration: underline; text-underline-offset: 4px; }
  .rail { position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: rgba(var(--color-rule), 0.18); }
  .rail span { display: block; height: 100%; background: rgb(var(--color-text-base)); transform: scaleY(var(--progress, 0)); transform-origin: top; }
  @media (max-width: 1160px) { .section-progress { display: none; } }
</style>
