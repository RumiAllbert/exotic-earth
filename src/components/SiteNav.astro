---
import { translator, localeFor, localizedPath } from "@/i18n";
const t = translator(Astro.url.pathname);
const locale = localeFor(Astro.url.pathname);
const local = (path: string) => localizedPath(path, locale);
import LanguageSelect from "./LanguageSelect.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";
import { basics } from "@cv";

const { name } = basics;
const given = name.split(" ")[0];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = localizedPath(path, "en") === "/";

const links = [
  { href: isHome ? "#experience" : "/#experience", label: "Work" },
  { href: isHome ? "#publications" : "/#publications", label: "Writing" },
  { href: isHome ? "#projects" : "/#projects", label: "Projects" },
  { href: isHome ? "#contact" : "/contact", label: "Contact" },
];
---

<header class="site-nav no-print">
  <a class="mark" href={local("/")} aria-label={name}>{given}</a>
  <nav aria-label={t("Sections")}>
    {
      links.map(({ href, label }) => (
        <a href={href.startsWith("/") ? local(href) : href}>{t(label)}</a>
      ))
    }
  </nav>
  <div class="tools">
    <button
      type="button"
      id="nav-cmdk"
      class="cmdk"
      aria-label={t("Open command palette")}
      aria-keyshortcuts="Meta+K Control+K"
      title={`${t("Open command palette")} (⌘K / Ctrl+K)`}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 8a3 3 0 1 0-3-3v14a3 3 0 1 0 3-3H5a3 3 0 1 0 3 3V5a3 3 0 1 0-3 3Z" />
      </svg>
    </button>
    {Astro.props.showLanguage !== false && <LanguageSelect />}
    <ThemeSwitch />
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0.75rem;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(64rem, calc(100% - 2rem));
    margin: 0.75rem auto 0;
    padding: 0.25rem 0.5rem 0.25rem 1.125rem;
    background: rgba(var(--color-fill), 0.68);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    backdrop-filter: blur(24px) saturate(140%);
    border: 1px solid rgba(var(--color-rule), 0.1);
    border-radius: 999px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .mark {
    font-style: italic;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: rgb(var(--color-text-base));
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.15rem;
    margin-left: auto;
  }

  nav a {
    font-size: 0.92rem;
    color: rgb(var(--color-text-muted));
    transition: color 160ms ease;
  }

  nav a:hover,
  nav a:focus-visible {
    color: rgb(var(--color-text-base));
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0;
    flex-shrink: 0;
  }

  .cmdk {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: rgb(var(--color-text-muted));
    background: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .tools :global(.cmdk),
  .tools :global(.language),
  .tools :global(.theme-switch) {
    transition: color 160ms ease, background-color 160ms ease;
  }

  .tools :global(.cmdk:hover),
  .tools :global(.language:hover),
  .tools :global(.theme-switch:hover) {
    color: rgb(var(--color-text-base));
    background-color: rgba(var(--color-rule), 0.06);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .site-nav { background: rgb(var(--color-fill)); }
  }

  @media (max-width: 640px) {
    nav { display: none; }
    .tools { margin-left: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    nav a, .tools :global(*) { transition: none; }
  }
</style>
