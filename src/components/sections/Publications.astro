---
import { publications } from "@cv";
import Section from "../Section.astro";

const GROUPS: Array<{ name: string; titles: string[] }> = [
  {
    name: "AI systems and evaluation",
    titles: [
      "Uncovering Candidate Potential with Multi-Modal AI Assessments",
      "Evaluating Speech-to-Text x LLM x Text-to-Speech Combinations for AI Interview Systems",
    ],
  },
  {
    name: "Philosophy of AI",
    titles: [
      "De Suspensione: Inflection, Composition, and the Long Drift Outward",
      "From Plato to Pixels: Imagination, AI, and the Whole",
      "PhiloBERTA: A Transformer-Based Cross-Lingual Analysis of Greek and Latin Lexicons",
    ],
  },
  {
    name: "Interpretability",
    titles: [
      "Identifying and Manipulating Personality Traits in LLMs Through Activation Engineering",
    ],
  },
];

const groupedPubs = GROUPS.map((group) => ({
  ...group,
  items: group.titles
    .map((title) => publications.find((paper) => paper.title === title))
    .filter((paper): paper is NonNullable<typeof paper> => Boolean(paper)),
}));

function authorLine(authors: string[]): string {
  const first = authors[0] ?? "";
  const isRumiFirst = /^Rumi/.test(first);
  if (!isRumiFirst) return authors.join(", ");
  const coAuthors = authors
    .slice(1)
    .filter((author) => !/et al\.?/i.test(author) && !/^Rumi/.test(author));
  return coAuthors.length
    ? `Lead author, with ${coAuthors.join(", ")}`
    : "Lead author";
}
---

<Section title="Publications">
  <div class="stack">
    {
      groupedPubs.map((group) => (
        <div class="group">
          <h3>{group.name}</h3>
          <ol>
            {group.items.map(
              ({
                title,
                authors,
                date,
                url,
                highlight,
                publisher,
                abstract,
                type,
              }) => {
                const year = new Date(date).getFullYear();
                return (
                  <li class="paper">
                    <a href={url} target="_blank" rel="noopener noreferrer">
                      <span class="year">{year}</span>
                      <span class="entry">
                        <cite>{title}</cite>
                        {highlight && <span class="note">{highlight}</span>}
                        <span class="meta">
                          {publisher} · {type} · {authorLine(authors)}
                        </span>
                      </span>
                    </a>
                    <details class="abstract-preview">
                      <summary aria-label={`Preview abstract: ${title}`}>Preview abstract <span aria-hidden="true">↗</span></summary>
                      <div class="preview-card"><strong>{title}</strong><p>{abstract}</p></div>
                    </details>
                  </li>
                );
              },
            )}
          </ol>
        </div>
      ))
    }
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".abstract-preview").forEach((details) => {
    const paper = details.closest(".paper")!;
    paper.addEventListener("pointerenter", (event) => {
      if ((event as PointerEvent).pointerType === "mouse") details.open = true;
    });
    paper.addEventListener("pointerleave", () => {
      if (!details.contains(document.activeElement)) details.open = false;
    });
    paper.addEventListener("keydown", (event) => {
      if ((event as KeyboardEvent).key === "Escape") details.open = false;
    });
    details.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        if (!paper.matches(":hover") && !details.contains(document.activeElement)) details.open = false;
      });
    });
  });
</script>

<style>
  .paper {
    position: relative;
    padding: 0.9rem 0;
    border-top: 1px solid rgba(var(--color-rule), 0.14);
    transition: background-color 160ms ease;
  }
  .paper:hover,
  .paper:focus-within {
    background: rgba(var(--color-rule), 0.035);
  }
  details {
    margin: 0.5rem 0 0 4.1rem;
  }
  summary {
    border: 1px solid rgba(var(--color-rule), 0.25);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    width: fit-content;
    font-size: 0.82rem;
    color: rgb(var(--color-text-muted));
  }
  .preview-card {
    position: absolute;
    left: 4.1rem;
    right: 0;
    z-index: 10;
    padding: 1.25rem;
    background: rgb(var(--color-fill));
    border: 1px solid rgba(var(--color-rule), 0.25);
    box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    max-height: 45vh;
    overflow-y: auto;
  }
  .preview-card strong { font-weight: 500; font-size: 1.08rem; }
  @media (max-width: 640px) {
    .preview-card { position: static; margin-top: 0.5rem; padding: 1rem; max-height: none; box-shadow: none; }
  }
  details p {
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0.65rem 0 0;
    max-width: 65ch;
  }
  @media (prefers-reduced-motion: reduce) {
    .paper {
      transition: none;
    }
  }
  @media print {
    details {
      display: none;
    }
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  h3 {
    font-style: italic;
    font-weight: 400;
    font-size: 1.15rem;
    color: rgb(var(--color-text-muted));
    margin-bottom: 0.7rem;
  }

  ol {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  a {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 0.9rem;
    align-items: start;
  }

  .year {
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
    color: rgb(var(--color-text-muted));
    padding-top: 0.2rem;
  }

  cite {
    display: block;
    font-style: normal;
    font-size: 1.15rem;
    color: rgb(var(--color-text-base));
    line-height: 1.35;
  }

  a:hover cite {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .note,
  .meta {
    display: block;
    margin-top: 0.28rem;
    font-size: 0.92rem;
    color: rgb(var(--color-text-muted));
  }

  .note {
    font-style: italic;
  }

  @media print {
    a {
      display: block;
    }
  }
</style>
