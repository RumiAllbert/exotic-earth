---
import { publications } from "@cv";
import Section from "../Section.astro";
import { Icon } from "astro-icon/components";

const GROUPS: Array<{ name: string; titles: string[] }> = [
  {
    name: "AI systems and evaluation",
    titles: [
      "Uncovering Candidate Potential with Multi-Modal AI Assessments",
      "Evaluating Speech-to-Text x LLM x Text-to-Speech Combinations for AI Interview Systems",
    ],
  },
  {
    name: "Philosophy of AI",
    titles: [
      "De Suspensione: Inflection, Composition, and the Long Drift Outward",
      "From Plato to Pixels: Imagination, AI, and the Whole",
      "PhiloBERTA: A Transformer-Based Cross-Lingual Analysis of Greek and Latin Lexicons",
    ],
  },
  {
    name: "Interpretability",
    titles: [
      "Identifying and Manipulating Personality Traits in LLMs Through Activation Engineering",
    ],
  },
];

const groupedPubs = GROUPS.map((group) => ({
  ...group,
  items: group.titles
    .map((title) => publications.find((paper) => paper.title === title))
    .filter((paper): paper is NonNullable<typeof paper> => Boolean(paper)),
}));

function authorLine(authors: string[]): string {
  const first = authors[0] ?? "";
  const isRumiFirst = /^Rumi/.test(first);
  if (!isRumiFirst) return authors.join(", ");
  const coAuthors = authors
    .slice(1)
    .filter((author) => !/et al\.?/i.test(author) && !/^Rumi/.test(author));
  return coAuthors.length
    ? `Lead author, with ${coAuthors.join(", ")}`
    : "Lead author";
}
---

<Section title="Publications">
  <div class="stack">
    {
      groupedPubs.map((group) => (
        <div class="group">
          <h3>{group.name}</h3>
          <ol>
            {group.items.map(
              ({
                title,
                authors,
                date,
                url,
                highlight,
                publisher,
                abstract,
                type,
              }) => {
                const year = new Date(date).getFullYear();
                return (
                  <li class="paper" data-publisher={publisher}>
                    <a href={url} target="_blank" rel="noopener noreferrer">
                      <span class="year">{year}</span>
                      <span class="entry">
                        <cite>{title}</cite>

                        <span class="meta">
                          <Icon name={publisher === "arXiv" ? "simple-icons:arxiv" : "simple-icons:researchgate"} class="publisher-logo" /> {publisher} · {type} · {authorLine(authors)}
                        </span>
                      </span>
                    </a>
                    <details class="abstract-preview">
                      <summary aria-label={`Preview abstract: ${title}`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M4 4h10v16H4zM7 8h4M7 12h3" /><path class="open-arrow" d="M12 12h9m-4-4 4 4-4 4" /></svg></summary>
                      <div class="preview-card"><strong>{title}</strong>{highlight && <p class="note">{highlight}</p>}<p>{abstract}</p></div>
                    </details>
                  </li>
                );
              },
            )}
          </ol>
        </div>
      ))
    }
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".abstract-preview").forEach((details) => {
    details.querySelector("summary")!.addEventListener("pointerenter", (event) => {
      if ((event as PointerEvent).pointerType === "mouse") details.open = true;
    });
    details.addEventListener("pointerleave", () => {
      if (!details.contains(document.activeElement)) details.open = false;
    });
    details.addEventListener("keydown", (event) => {
      if ((event as KeyboardEvent).key === "Escape") details.open = false;
    });
    details.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        if (!details.matches(":hover") && !details.contains(document.activeElement)) details.open = false;
      });
    });
  });
</script>

<style>
  .publisher-logo { display: inline-block; width: 0.75rem; height: 0.75rem; vertical-align: -0.05rem; margin-right: 0.2rem; }
  .paper {
    position: relative;
    padding: 0.65rem 0;
    min-height: 4.4rem;
    border-top: 1px solid rgba(var(--color-rule), 0.14);
    transition: background-color 160ms ease;
  }
  .paper:hover,
  .paper:focus-within {
    background: rgba(var(--color-rule), 0.035);
  }
  details {
    pointer-events: none;
    position: absolute;
    top: 2rem;
    left: 0;
    right: 0;
  }
  summary {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    list-style: none;
    cursor: pointer;
    width: 28px;
    height: 28px;
    color: rgb(var(--color-text-muted));
  }
  summary::-webkit-details-marker { display: none; }
  .open-arrow { transition: transform 180ms ease; }
  details[open] .open-arrow { transform: translateX(2px); }
  .paper[data-publisher="arXiv"] > a:hover .publisher-logo { color: #b34c4c; }
  .paper[data-publisher="ResearchGate"] > a:hover .publisher-logo { color: #00a88a; }
  .publisher-logo { transition: color 180ms ease; }
  @keyframes reveal-abstract {
    from { opacity: 0; transform: translateX(-8px); clip-path: inset(0 100% 0 0); }
    to { opacity: 1; transform: translateX(0); clip-path: inset(0); }
  }
  .preview-card {
    pointer-events: auto;
    position: absolute;
    top: 0;
    left: 3.2rem;
    right: 0;
    z-index: 10;
    padding: 1.25rem;
    animation: reveal-abstract 180ms ease-out;
    background: rgb(var(--color-fill));
    border: 1px solid rgba(var(--color-rule), 0.25);
    box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    max-height: 45vh;
    overflow-y: auto;
  }
  .preview-card strong { font-weight: 500; font-size: 1.08rem; }
  @media (max-width: 640px) {
    details[open] { position: relative; top: auto; margin: 0.2rem 0 0 4.1rem; }
    .preview-card { position: static; margin-top: 0.5rem; padding: 1rem; max-height: none; box-shadow: none; }
  }
  details p {
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0.65rem 0 0;
    max-width: 65ch;
  }
  @media (prefers-reduced-motion: reduce) {
    .preview-card { animation: none; }
    .paper, .open-arrow, .publisher-logo {
      transition: none;
    }
  }
  @media print {
    details {
      display: none;
    }
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  h3 {
    font-style: italic;
    font-weight: 400;
    font-size: 1.15rem;
    color: rgb(var(--color-text-muted));
    margin-bottom: 0.4rem;
  }

  ol {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  a {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 0.9rem;
    align-items: start;
  }

  .year {
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
    color: rgb(var(--color-text-muted));
    padding-top: 0.2rem;
  }

  cite {
    display: block;
    font-style: normal;
    font-size: 1.05rem;
    color: rgb(var(--color-text-base));
    line-height: 1.35;
  }

  a:hover cite {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .note,
  .meta {
    display: block;
    margin-top: 0.28rem;
    font-size: 0.92rem;
    color: rgb(var(--color-text-muted));
  }

  .note {
    font-style: italic;
  }

  @media print {
    a {
      display: block;
    }
  }
</style>
