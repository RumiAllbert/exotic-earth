---
import { publications } from "@cv";
import Section from "../Section.astro";

const GROUPS: Array<{ name: string; titles: string[] }> = [
  {
    name: "AI systems and evaluation",
    titles: [
      "Uncovering Candidate Potential with Multi-Modal AI Assessments",
      "Evaluating Speech-to-Text x LLM x Text-to-Speech Combinations for AI Interview Systems",
    ],
  },
  {
    name: "Philosophy of AI",
    titles: [
      "De Suspensione: Inflection, Composition, and the Long Drift Outward",
      "From Plato to Pixels: Imagination, AI, and the Whole",
      "PhiloBERTA: A Transformer-Based Cross-Lingual Analysis of Greek and Latin Lexicons",
    ],
  },
  {
    name: "Interpretability",
    titles: [
      "Identifying and Manipulating Personality Traits in LLMs Through Activation Engineering",
    ],
  },
];

const groupedPubs = GROUPS.map((group) => ({
  ...group,
  items: group.titles
    .map((title) => publications.find((paper) => paper.title === title))
    .filter((paper): paper is NonNullable<typeof paper> => Boolean(paper)),
}));

function authorLine(authors: string[]): string {
  const first = authors[0] ?? "";
  const isRumiFirst = /^Rumi/.test(first);
  if (!isRumiFirst) return authors.join(", ");
  const coAuthors = authors
    .slice(1)
    .filter((author) => !/et al\.?/i.test(author) && !/^Rumi/.test(author));
  return coAuthors.length
    ? `Lead author, with ${coAuthors.join(", ")}`
    : "Lead author";
}
---

<Section title="Publications">
  <div class="stack">
    {
      groupedPubs.map((group) => (
        <div class="group">
          <h3>{group.name}</h3>
          <ol>
            {group.items.map(
              ({ title, authors, date, url, highlight, publisher }) => {
                const year = new Date(date).getFullYear();
                return (
                  <li>
                    <a href={url} target="_blank" rel="noopener noreferrer">
                      <span class="year">{year}</span>
                      <span class="entry">
                        <cite>{title}</cite>
                        {highlight && <span class="note">{highlight}</span>}
                        <span class="meta">
                          {publisher}, {authorLine(authors)}
                        </span>
                      </span>
                    </a>
                  </li>
                );
              },
            )}
          </ol>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  h3 {
    font-style: italic;
    font-weight: 400;
    font-size: 1.15rem;
    color: rgb(var(--color-text-muted));
    margin-bottom: 0.7rem;
  }

  ol {
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
  }

  a {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 0.9rem;
    align-items: start;
  }

  .year {
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
    color: rgb(var(--color-text-muted));
    padding-top: 0.2rem;
  }

  cite {
    display: block;
    font-style: normal;
    font-size: 1.05rem;
    color: rgb(var(--color-text-base));
    line-height: 1.35;
  }

  a:hover cite {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .note,
  .meta {
    display: block;
    margin-top: 0.28rem;
    font-size: 0.92rem;
    color: rgb(var(--color-text-muted));
  }

  .note {
    font-style: italic;
  }

  @media print {
    a {
      display: block;
    }
  }
</style>
