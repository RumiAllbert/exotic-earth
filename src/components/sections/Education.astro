---
import Section from "../Section.astro";
import { education } from "@cv";

function yearOf(date?: string | null): string {
  if (!date) return "Present";
  const year = date.slice(0, 4);
  return /^\d{4}$/.test(year) ? year : "Present";
}
---

<Section className={Astro.props.className} title="Education">
  <ol class="schools">
    {
      education.map(
        ({ institution, startDate, endDate, area, url, studyType, highlights }) => (
          <li>
            <header>
              <h3>
                {url ? (
                  <a href={url} target="_blank" rel="noopener noreferrer">
                    {institution}
                  </a>
                ) : (
                  institution
                )}
              </h3>
              <p class="when">
                {yearOf(startDate)}–{yearOf(endDate)}
              </p>
            </header>
            <p class="course">
              {studyType} in {area}
            </p>
            {highlights && highlights.length > 0 && (
              <ul>
                {highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
          </li>
        ),
      )
    }
  </ol>
</Section>

<style>
  .schools {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }

  h3 {
    font-size: 1.12rem;
    font-weight: 400;
  }

  h3 a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .when {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-size: 0.88rem;
    color: rgb(var(--color-text-muted));
  }

  .course {
    margin: 0.15rem 0 0;
    font-size: 0.95rem;
    color: rgb(var(--color-text-muted));
  }

  .schools ul {
    margin-top: 0.4rem;
    padding-left: 1.1rem;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.92rem;
    color: rgb(var(--color-text-muted));
  }

  @media print {
    .schools li {
      break-inside: avoid;
    }
  }
</style>
