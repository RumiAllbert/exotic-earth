---
import Section from "../Section.astro";
import { news } from "@/data/news";
---

<Section title="News & appearances">
  <ol class="coverage">
    {news.map(({ title, publisher, date, kind, description, url }) => (
      <li>
        <p class="meta">
          {publisher} · {kind} · <time datetime={date}>{new Date(`${date}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" })}</time>
        </p>
        <h3><a href={url} target="_blank" rel="noopener noreferrer">{title} ↗</a></h3>
        <p class="description">{description}</p>
      </li>
    ))}
  </ol>
</Section>

<style>
  .coverage { list-style: none; margin: 0; padding: 0; }
  li { padding: 1rem 0; border-top: 1px solid rgba(var(--color-rule), 0.12); }
  li:last-child { padding-bottom: 0; }
  .meta { margin: 0 0 0.3rem; font-size: 0.85rem; color: rgb(var(--color-text-muted)); }
  h3 { font-size: 1.15rem; font-weight: 400; line-height: 1.35; }
  a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .description { margin: 0.35rem 0 0; font-size: 0.95rem; }
  @media print { li { break-inside: avoid; } }
</style>
