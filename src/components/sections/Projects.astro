---
import { translator } from "@/i18n";
const t = translator(Astro.url.pathname);
import Section from "../Section.astro";
import { projects } from "@cv";

const FEATURED: Record<string, { src: string; alt: string }> = {
  "Etymon.ai": {
    src: "/projects/etymon.webp",
    alt: "Etymon — Discover the origin of words",
  },
  Vertor: {
    src: "/projects/vertor.webp",
    alt: "Vertor — Translate. Refine. Ship.",
  },
};

const featuredNames = ["Etymon.ai", "Vertor"];
const featured = featuredNames
  .map((name) => projects.find((project) => project.name === name))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));
const rest = projects.filter((project) => !FEATURED[project.name]);
---

<Section className={Astro.props.className} title="Projects">
  <div class="plates no-print">
    {
      featured.map(({ name, url, description }) => {
        const image = FEATURED[name];
        return (
          <a class="plate" href={url} target="_blank" rel="noopener noreferrer">
            <img src={image.src} alt={t(image.alt)} width="1200" height="630" loading="lazy" />
            <span>
              <strong>{name}</strong>
              {t(description)}
            </span>
          </a>
        );
      })
    }
  </div>
  <ul class="catalog">
    {
      rest.map(({ url, description, highlights, name, isActive, github }) => (
        <li class="work" x-data="{ expanded: false }">
          <div class="row">
            <h3>{name}</h3>
            <p class="deck">{t(description)}</p>
            <div class="actions">
              {isActive && url && (
                <a href={url} target="_blank" rel="noopener noreferrer">
                  {t("Live")}
                </a>
              )}
              {github && (
                <a
                  href={github}
                  title={`${t("Repository for")} ${name}`}
                  target="_blank"
                  rel="noopener"
                >
                  {t("Code")}
                </a>
              )}
              {highlights?.length > 0 && (
                <button
                  type="button"
                  class="no-print"
                  @click="expanded = !expanded"
                  :aria-expanded="expanded"
                >
                  <span x-text={`expanded ? ${JSON.stringify(t("Less"))} : ${JSON.stringify(t("Notes"))}`}>{t("Notes")}</span>
                </button>
              )}
            </div>
          </div>
          {highlights?.length > 0 && (
            <ul class="notes" x-show="expanded" x-collapse>
              {highlights.map((highlight) => (
                <li>{t(highlight)}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .plates {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .plate {
    display: block;
    color: inherit;
  }

  .plate img {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    object-position: center;
    background: rgb(var(--muted));
    border: 1px solid rgba(var(--color-rule), 0.1);
  }

  .plate span {
    display: block;
    margin-top: 0.7rem;
    font-size: 0.95rem;
    color: rgb(var(--color-text-muted));
  }

  .plate strong {
    display: block;
    font-size: 1.2rem;
    font-weight: 500;
    color: rgb(var(--color-text-base));
    margin-bottom: 0.15rem;
  }

  .plate:hover strong {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 720px) {
    .plates {
      grid-template-columns: 1fr 1fr;
    }
  }

  .catalog {
    display: flex;
    flex-direction: column;
  }

  .work {
    padding: 1.05rem 0;
    border-top: 1px solid rgba(var(--color-rule), 0.12);
  }

  .work:last-child {
    border-bottom: 1px solid rgba(var(--color-rule), 0.12);
  }

  .row {
    display: grid;
    gap: 0.35rem 1.5rem;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 500;
  }

  .deck {
    margin: 0;
    font-size: 0.98rem;
    color: rgb(var(--color-text-muted));
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 0.35rem;
    font-style: italic;
    font-size: 0.95rem;
  }

  .actions a,
  .actions button {
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    color: rgb(var(--color-text-base));
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .actions a:hover,
  .actions button:hover {
    color: rgb(var(--color-text-muted));
  }

  .notes {
    margin-top: 0.7rem;
    padding-left: 1.1rem;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.92rem;
    color: rgb(var(--color-text-muted));
  }

  @media (min-width: 720px) {
    .row {
      grid-template-columns: 11rem 1fr auto;
      align-items: baseline;
    }

    .actions {
      margin-top: 0;
      justify-content: flex-end;
    }
  }

  @media print {
    .notes {
      display: block !important;
    }
  }
</style>
