---
import { basics } from "@cv";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import X from "@/icons/X.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import type { SocialIcon } from "@/types";

const { name, label, location, profiles, phone, email } = basics;
const { city, region } = location;

const SOCIAL_ICONS: SocialIcon = {
  GitHub,
  LinkedIn,
  X,
};

const linkedUrl = profiles.find(({ network }) => network === "LinkedIn")?.url;
const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" · ");
---

<header class="hero">
  <div class="copy">
    <h1>{name}</h1>
    <p class="lede">I lead RL environments and post-training at micro1.</p>
    <p class="role">{label}</p>
    <p class="place">{city === region ? city : `${city}, ${region}`}</p>

    <p class="print">{printInfo}</p>
    <p class="no-print links">
      {
        email && (
          <a href={`mailto:${email}`} aria-label="Email">
            <Mail />
          </a>
        )
      }
      {
        phone && (
          <a href={`tel:${phone}`} aria-label="Phone">
            <Phone />
          </a>
        )
      }
      {
        profiles.map(({ network, url }) => {
          const Icon = SOCIAL_ICONS[network];
          return (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={network}
            >
              <Icon />
            </a>
          );
        })
      }
    </p>
  </div>

  <figure class="portrait">
    <img
      src="/me_avatar01.jpg"
      alt={name}
      width="360"
      height="450"
    />
  </figure>
</header>

<style>
  .hero {
    width: min(52rem, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 3.5rem 0 2.25rem;
    display: grid;
    grid-template-columns: 1fr 5.75rem;
    gap: 1.25rem 1.5rem;
    align-items: start;
    border-bottom: 1px solid rgba(var(--color-rule), 0.1);
  }

  .portrait {
    margin: 0;
    width: 5.75rem;
  }

  .portrait img {
    display: block;
    width: 5.75rem;
    height: 7.2rem;
    object-fit: cover;
    object-position: center 18%;
    filter: saturate(0.9) contrast(1.04);
  }

  h1 {
    font-size: clamp(2.6rem, 5.5vw, 4.1rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }




  .role {
    margin: 1.35rem 0 0;
    font-size: 0.85rem;
    color: rgb(var(--color-text-muted));
  }

  .lede {
    margin: 1.5rem 0 0;
    max-width: 36ch;
    font-size: 1.3rem;
    color: rgb(var(--color-text-muted));
  }

  .place {
    margin: 0.95rem 0 0;
    font-size: 0.95rem;
    color: rgb(var(--color-text-muted));
  }


  .links {
    display: flex;
    gap: 0.35rem;
    margin: 1.15rem 0 0;
    color: rgb(var(--color-text-muted));
  }

  .links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.15rem;
    height: 2.15rem;
  }

  .links a:hover {
    color: rgb(var(--color-text-base));
  }


  @media (min-width: 640px) {
    .hero {
      grid-template-columns: 1fr 7.25rem;
      gap: 1.5rem 2rem;
      padding: 5.5rem 0 3.5rem;
    }

    .portrait,
    .portrait img {
      width: 7.25rem;
      height: 9.1rem;
    }
  }

  @media screen and (max-width: 639px) {
    .hero { display: block; position: relative; }
    h1 { padding-right: 5.5rem; }
    .portrait { position: absolute; right: 0; top: 3.5rem; }
    .portrait, .portrait img { width: 4rem; height: 5rem; }
    .lede { font-size: 1.2rem; line-height: 1.5; }
  }

  @media print {
    .hero {
      width: 100%;
      padding: 0;
      animation: none;
      grid-template-columns: 1fr 5rem;
    }

    .portrait,
    .portrait img {
      width: 5rem;
      height: 6.25rem;
    }

    h1 {
      font-size: 18pt;
    }


  }
</style>
