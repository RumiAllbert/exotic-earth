---
import { basics } from "@cv";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import X from "@/icons/X.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import type { SocialIcon } from "@/types";

const { name, label, location, profiles, phone, email } = basics;
const { city, region } = location;

const SOCIAL_ICONS: SocialIcon = {
  GitHub,
  LinkedIn,
  X,
};

const linkedUrl = profiles.find(({ network }) => network === "LinkedIn")?.url;
const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" · ");
---

<header class="hero hero-animate">
  <div class="copy">
    <h1>
      {
        name.split(" ").map((word, i) => (
          <span class:list={[{ "display-italic": i >= 2 }]}>{word} </span>
        ))
      }
    </h1>

    <p class="epigraph" lang="grc">
      πάντες ἄνθρωποι τοῦ εἰδέναι ὀρέγονται φύσει.
    </p>
    <p class="translation">
      All human beings by nature stretch toward knowing.
    </p>

    <p class="role">{label}, micro1</p>
    <p class="lede">I lead RL environments and post-training.</p>

    <p class="place">{city === region ? city : `${city}, ${region}`}</p>

    <ul class="tongues" aria-label="Languages">
      <li lang="en">English</li>
      <li lang="es">Español</li>
      <li lang="zh">中文</li>
      <li lang="it">Italiano</li>
      <li lang="la">Latin</li>
      <li lang="grc">Attic Greek</li>
    </ul>

    <p class="print">{printInfo}</p>
    <p class="no-print links">
      {
        email && (
          <a href={`mailto:${email}`} aria-label="Email">
            <Mail />
          </a>
        )
      }
      {
        phone && (
          <a href={`tel:${phone}`} aria-label="Phone">
            <Phone />
          </a>
        )
      }
      {
        profiles.map(({ network, url }) => {
          const Icon = SOCIAL_ICONS[network];
          return (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={network}
            >
              <Icon />
            </a>
          );
        })
      }
    </p>
  </div>

  <figure class="portrait">
    <img
      src="/me_avatar01.jpg"
      alt={name}
      width="360"
      height="450"
    />
  </figure>
</header>

<style>
  .hero {
    width: min(52rem, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 3.5rem 0 2.25rem;
    display: grid;
    grid-template-columns: 1fr 5.75rem;
    gap: 1.25rem 1.5rem;
    align-items: start;
    border-bottom: 1px solid rgba(var(--color-rule), 0.1);
  }

  .portrait {
    margin: 0;
    width: 5.75rem;
  }

  .portrait img {
    display: block;
    width: 5.75rem;
    height: 7.2rem;
    object-fit: cover;
    object-position: center 18%;
    filter: saturate(0.9) contrast(1.04);
  }

  h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .display-italic {
    font-family: "EB Garamond", Newsreader, Georgia, serif;
    font-style: italic;
    font-weight: 400;
  }

  .epigraph {
    margin: 1.15rem 0 0;
    font-family: "EB Garamond", Newsreader, Georgia, serif;
    font-style: italic;
    font-size: 1.05rem;
    color: rgb(var(--color-text-muted));
  }

  .translation {
    margin: 0.2rem 0 0;
    font-style: italic;
    font-size: 0.95rem;
    color: rgb(var(--color-text-muted));
  }

  .role {
    margin: 1.35rem 0 0;
    font-size: 1.05rem;
    color: rgb(var(--color-text-base));
  }

  .lede {
    margin: 0.45rem 0 0;
    max-width: 36ch;
    font-size: 1.05rem;
    color: rgb(var(--color-text-muted));
  }

  .place {
    margin: 0.95rem 0 0;
    font-size: 0.95rem;
    color: rgb(var(--color-text-muted));
  }

  .tongues {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin: 1.05rem 0 0;
    font-style: italic;
    font-size: 0.95rem;
    color: rgb(var(--color-text-muted));
  }

  .links {
    display: flex;
    gap: 0.35rem;
    margin: 1.15rem 0 0;
    color: rgb(var(--color-text-muted));
  }

  .links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.15rem;
    height: 2.15rem;
  }

  .links a:hover {
    color: rgb(var(--color-text-base));
  }

  .hero-animate {
    animation: rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 640px) {
    .hero {
      grid-template-columns: 1fr 7.25rem;
      gap: 1.5rem 2rem;
      padding: 4.25rem 0 2rem;
    }

    .portrait,
    .portrait img {
      width: 7.25rem;
      height: 9.1rem;
    }
  }

  @media print {
    .hero {
      width: 100%;
      padding: 0;
      animation: none;
      grid-template-columns: 1fr 5rem;
    }

    .portrait,
    .portrait img {
      width: 5rem;
      height: 6.25rem;
    }

    h1 {
      font-size: 18pt;
    }

    .epigraph,
    .translation,
    .tongues {
      display: none;
    }
  }
</style>
