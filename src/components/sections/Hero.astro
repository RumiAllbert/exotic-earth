---
import { translator } from "@/i18n";
const t = translator(Astro.url.pathname);
import { basics } from "@cv";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import X from "@/icons/X.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import type { SocialIcon } from "@/types";

const { name, profiles, phone, email } = basics;

const SOCIAL_ICONS: SocialIcon = {
  GitHub,
  LinkedIn,
  X,
};

const linkedUrl = profiles.find(({ network }) => network === "LinkedIn")?.url;
const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" · ");
---

<header class="hero hero-animate">
  <div class="copy">
    <h1>
      <span>{name.split(" ").slice(0, 2).join(" ")}</span>{" "}
      <span class="display-italic">{name.split(" ").slice(2).join(" ")}</span>
    </h1>


    <ul class="tongues" aria-label={t("Languages")}>
      <li lang="en">English</li>
      <li lang="es-MX">Español</li>
      <li lang="zh-Hant">中文</li>
      <li lang="it">Italiano</li>
      <li lang="la">Latina</li>
      <li lang="grc">Ἑλληνική</li>
    </ul>

    <p class="print">{printInfo}</p>
    <p class="no-print links">
      {
        email && (
          <a href={`mailto:${email}`} aria-label={t("Email")}>
            <Mail />
          </a>
        )
      }
      {
        phone && (
          <a href={`tel:${phone}`} aria-label={t("Phone")}>
            <Phone />
          </a>
        )
      }
      {
        profiles.map(({ network, url }) => {
          const Icon = SOCIAL_ICONS[network];
          return (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={network}
            >
              <Icon />
            </a>
          );
        })
      }
    </p>
  </div>
</header>

<style>
  a :global(svg) { transition: color 180ms ease; }
  a:hover :global(svg), a:focus-visible :global(svg) { color: #719d8d; }
  a[href*="linkedin"]:hover :global(svg), a[href*="linkedin"]:focus-visible :global(svg) { color: #0a66c2; }
  .hero {
    width: min(52rem, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 3.5rem 0 2.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem 1.5rem;
    align-items: start;
    border-bottom: 1px solid rgba(var(--color-rule), 0.1);
  }

  .copy {
    min-width: 0;
  }

  h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .display-italic {
    display: block;
    white-space: nowrap;
    font-family: "EB Garamond", Newsreader, Georgia, serif;
    font-style: italic;
    font-weight: 400;
  }


  .tongues {
    display: flex;
    gap: 1.1rem;
    margin: 1.05rem 0 0;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    font-style: italic;
    font-size: 0.95rem;
    color: rgb(var(--color-text-muted));
  }

  .tongues::-webkit-scrollbar {
    display: none;
  }

  .links {
    display: flex;
    gap: 0.35rem;
    margin: 1.15rem 0 0;
    color: rgb(var(--color-text-muted));
  }

  .links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.15rem;
    height: 2.15rem;
  }

  .links a:hover {
    color: rgb(var(--color-text-base));
  }

  .hero-animate {
    animation: rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 640px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 1.5rem 2rem;
      padding: 4.25rem 0 2rem;
    }
  }

  @media print {
    .hero {
      width: 100%;
      padding: 0;
      animation: none;
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: 18pt;
    }

    .tongues {
      display: none;
    }
  }
</style>
