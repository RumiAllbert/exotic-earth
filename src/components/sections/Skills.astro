---
import Section from "../Section.astro";
import { skills } from "@cv";
import { Icon } from "astro-icon/components";

type IconMap = {
  [key: string]: string;
};

export const iconMap: IconMap = {
  javascript: "simple-icons:javascript",
  python: "simple-icons:python",
  react: "simple-icons:react",
  typescript: "simple-icons:typescript",
  docker: "simple-icons:docker",
  kubernetes: "simple-icons:kubernetes",
  git: "simple-icons:git",
  github: "simple-icons:github",
  aws: "simple-icons:amazonaws",
  googlecloud: "simple-icons:googlecloud",
  postgresql: "simple-icons:postgresql",
  redis: "simple-icons:redis",
  go: "simple-icons:go",
  mcp: "/skill-logos/mcp.svg",
  transformers: "simple-icons:huggingface",
  harbor: "/skill-logos/harbor.ico",
  langgraph: "/skill-logos/langgraph.svg",
  huggingface: "simple-icons:huggingface",
  pytorch: "simple-icons:pytorch",
  pandas: "simple-icons:pandas",
  wandb: "simple-icons:weightsandbiases",
  numpy: "simple-icons:numpy",
  fastapi: "simple-icons:fastapi",
  ollama: "simple-icons:ollama",
  plotly: "simple-icons:plotly",
  streamlit: "simple-icons:streamlit",
  polars: "simple-icons:polars",
  spark: "simple-icons:apachespark",
  mathematica: "simple-icons:wolframmathematica",
  openenv: "/skill-logos/openenv.png",
  vllm: "/skill-logos/vllm.png",
  litellm: "/skill-logos/litellm.svg",
  transformerlens: "/skill-logos/transformerlens.svg",
  verifiers: "/skill-logos/verifiers.png",
  unsloth: "/skill-logos/unsloth.png",
  hive: "simple-icons:apachehive",
  mysql: "simple-icons:mysql",
  apachesuperset: "simple-icons:apachesuperset",
  wordpress: "simple-icons:wordpress",
  qgis: "simple-icons:qgis",
  mongodb: "simple-icons:mongodb",
  php: "simple-icons:php",
  nodejs: "simple-icons:nodedotjs",
  "node.js": "simple-icons:nodedotjs",
};

export const logoColors: Record<string, string> = {
  python: '#3776ab', transformers: '#d6a82b', huggingface: '#d6a82b', pytorch: '#ee4c2c',
  typescript: '#3178c6', docker: '#2496ed', kubernetes: '#326ce5', git: '#f05032',
  github: '#8878b5', aws: '#d79736', googlecloud: '#4285f4', postgresql: '#4169a1',
  redis: '#dc382d', go: '#00add8', pandas: '#8273b5', numpy: '#4dabcf',
  wandb: '#d7a637', fastapi: '#009688', ollama: '#8c9891', plotly: '#6c83d8',
  streamlit: '#ff4b4b', polars: '#cd8d3e', spark: '#e25a1c', mathematica: '#dd1100',
};

function getIconName(keyword: string) {
  const lowercaseKeyword = keyword.toLowerCase().replace(/\s+/g, "");
  return (iconMap as IconMap)[lowercaseKeyword] || null;
}

const coreCompetencies =
  skills.find((group) => group.name === "Focus")?.keywords ?? [];
const secondaryGroups = skills.filter((group) => group.name !== "Focus");
---

<Section className={Astro.props.className} title="Skills">
  <div class="stack">
    {
      coreCompetencies.length > 0 && (
        <p class="focus">{coreCompetencies.join(", ")}</p>
      )
    }
    {
      secondaryGroups.map((group) => (
        <div class="group">
          <h3>{group.name}</h3>
          <ul>
            {group.keywords.map((keyword) => {
              const iconName = getIconName(keyword);
              const isImageAsset = iconName?.startsWith("/");
              return (
                <li style={`--logo-color: ${logoColors[keyword.toLowerCase().replace(/\s+/g, "")] ?? "#719d8d"}`}>
                  {iconName && !isImageAsset && (
                    <Icon name={iconName} class="skill-logo h-3.5 w-3.5" />
                  )}
                  {iconName && isImageAsset && ["Harbor", "LangGraph"].includes(keyword) && <img class="image-logo" src={iconName} alt="" width="14" height="14" />}
                  {iconName && isImageAsset && !["Harbor", "LangGraph"].includes(keyword) && (
                    <span
                      class="asset"
                      style={`-webkit-mask: url(${iconName}) center / contain no-repeat; mask: url(${iconName}) center / contain no-repeat;`}
                      aria-hidden="true"
                    />
                  )}
                  {keyword}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .skill-logo, .asset { transition: color 180ms ease; }
  li:hover .skill-logo, li:hover .asset { color: var(--logo-color); }
  .image-logo { width: 0.9rem; height: 0.9rem; object-fit: contain; filter: grayscale(1); opacity: .8; transition: filter 180ms ease, opacity 180ms ease; }
  .image-logo[src$="harbor.ico"] { background: #eee; border-radius: 50%; }
  li:hover .image-logo[src$="harbor.ico"] { filter: sepia(.5); }
  li:hover .image-logo { filter: grayscale(.2); opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .skill-logo, .asset, .image-logo { transition: none; } }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .focus {
    margin: 0;
    font-style: italic;
    font-size: 1.15rem;
    color: rgb(var(--color-text-base));
  }

  h3 {
    font-style: italic;
    font-weight: 400;
    font-size: 1.05rem;
    color: rgb(var(--color-text-muted));
    margin-bottom: 0.45rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    color: rgb(var(--color-text-muted));
  }

  .asset {
    display: inline-block;
    width: 0.9rem;
    height: 0.9rem;
    background: currentColor;
  }
</style>
