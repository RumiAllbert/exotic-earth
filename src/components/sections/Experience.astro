---
import Section from "../Section.astro";
import { work } from "@cv";
import { Icon } from "astro-icon/components";
import { iconMap } from "./Skills.astro";

type WorkItem = {
  name: string;
  position: string;
  location_type: string;
  location: string;
  url?: string;
  startDate: string;
  endDate: string | null;
  summary: string | string[];
  highlights: string[];
  responsibilities?: string[];
  achievements?: string[];
  skills: string[];
};

function yearOf(date: string | null): string {
  if (!date) return "Present";
  const year = date.slice(0, 4);
  return /^\d{4}$/.test(year) ? year : "Present";
}

function getIconName(skill: string): string | null {
  const key = skill.toLowerCase().replace(/\s+/g, "");
  return iconMap[key] || null;
}
---

<Section className={Astro.props.className} title="Experience">
  <ol class="posts">
    {
      (work as WorkItem[]).map(
        ({
          name,
          startDate,
          endDate,
          position,
          summary,
          highlights,
          responsibilities,
          achievements,
          url,
          skills,
          location,
          location_type,
        }) => {
          const hasSummary = Array.isArray(summary)
            ? summary.length > 0
            : Boolean(summary);
          const hasExtra =
            hasSummary ||
            Boolean(location || location_type) ||
            (highlights?.length ?? 0) > 0 ||
            (responsibilities?.length ?? 0) > 0 ||
            (achievements?.length ?? 0) > 0 ||
            (skills?.length ?? 0) > 0;

          return (
            <li class="post timeline-item" x-data="{ expanded: false }">
              <div class="track" aria-hidden="true">
                <span class="dot"></span>
              </div>
              <header class="when">
                <time datetime={startDate}>{yearOf(startDate)}</time>
                <span aria-hidden="true">–</span>
                <time datetime={endDate ?? undefined}>{yearOf(endDate)}</time>
              </header>
              <div class="body">
                <div class="head">
                  <h3>
                    <span class="role">{position}</span>
                    <span class="at"> at </span>
                    {url ? (
                      <a href={url} title={`Visit ${name}`} target="_blank" rel="noopener noreferrer">
                        {name}
                      </a>
                    ) : (
                      <span class="org">{name}</span>
                    )}
                  </h3>
                  {hasExtra && (
                    <button
                      type="button"
                      class="more no-print"
                      @click="expanded = !expanded"
                      :aria-expanded="expanded"
                      aria-label={`Expand details: ${position} at ${name}`}
                    >
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true" :style="expanded ? 'transform: rotate(180deg)' : ''"><path d="m4 6 4 4 4-4" /></svg>
                    </button>
                  )}
                </div>
                {hasExtra && (
                  <div class="notes" x-cloak x-show="expanded" x-collapse>
                    {(location || location_type) && (
                      <p class="meta">
                        {[location, location_type].filter(Boolean).join(", ")}
                      </p>
                    )}
                    {hasSummary && (
                      <div class="blurb">
                        {Array.isArray(summary) ? (
                          <ul>
                            {summary.map((item) => (
                              <li>{item}</li>
                            ))}
                          </ul>
                        ) : (
                          <p>{summary}</p>
                        )}
                      </div>
                    )}
                    {highlights?.length > 0 && (
                      <ul>
                        {highlights.map((highlight) => (
                          <li>{highlight}</li>
                        ))}
                      </ul>
                    )}
                    {responsibilities && responsibilities.length > 0 && (
                      <ul>
                        {responsibilities.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    )}
                    {skills && skills.length > 0 && (
                      <ul class="tech no-print">
                        {skills.map((skill) => {
                          const iconName = getIconName(skill);
                          return (
                            <li>
                              {iconName && !iconName.startsWith("/") && (
                                <Icon class="icon" name={iconName} />
                              )}
                              {skill}
                            </li>
                          );
                        })}
                      </ul>
                    )}
                  </div>
                )}
              </div>
            </li>
          );
        },
      )
    }
  </ol>
</Section>

<script>
  function setupTimeline() {
    const items = Array.from(document.querySelectorAll(".timeline-item"));
    if (!items.length) return;

    const fill = () => {
      const viewport = window.innerHeight;
      items.forEach((item) => {
        const rect = item.getBoundingClientRect();
        const start = viewport * 0.88;
        const end = viewport * 0.22;
        const progress = (start - rect.top) / (start - end);
        (item as HTMLElement).style.setProperty(
          "--fill",
          `${Math.min(1, Math.max(0, progress))}`,
        );
      });
    };

    fill();
    window.addEventListener("scroll", fill, { passive: true });
    window.addEventListener("resize", fill, { passive: true });
  }

  setupTimeline();
  document.addEventListener("astro:page-load", setupTimeline);
</script>

<style>
  .posts {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .post {
    display: grid;
    grid-template-columns: 0.85rem 5.5rem 1fr;
    gap: 0.1rem 0.75rem;
    padding: 0.28rem 0;
    align-items: start;
  }

  .track {
    position: relative;
  }

  .track::before {
    content: "";
    position: absolute;
    left: 0.26rem;
    top: 0.45rem;
    bottom: -0.28rem;
    width: 1px;
    background: rgba(var(--color-rule), 0.16);
  }

  .track::after {
    content: "";
    position: absolute;
    left: 0.26rem;
    top: 0.45rem;
    bottom: -0.28rem;
    width: 1px;
    background: rgb(var(--color-lamp));
    transform: scaleY(var(--fill, 0));
    transform-origin: top;
  }

  .post:last-child .track::before,
  .post:last-child .track::after {
    bottom: 0.35rem;
  }

  .dot {
    position: absolute;
    left: 0.05rem;
    top: 0.38rem;
    z-index: 1;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--color-lamp), 0.55);
    background: rgb(var(--color-fill));
    box-shadow: 0 0 0 2px rgb(var(--color-fill));
  }

  .when {
    font-variant-numeric: tabular-nums;
    font-size: 0.78rem;
    color: rgb(var(--color-text-muted));
    padding-top: 0.18rem;
    white-space: nowrap;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  h3 {
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .role {
    color: rgb(var(--color-text-base));
  }

  .at {
    color: rgb(var(--color-text-muted));
  }

  h3 a,
  .org {
    color: rgb(var(--color-text-base));
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .meta,
  .blurb p,
  .blurb li,
  .notes li {
    font-size: 0.9rem;
    color: rgb(var(--color-text-muted));
  }

  .meta {
    margin: 0;
  }

  .blurb ul,
  .notes ul:not(.tech) {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    padding-left: 1rem;
    list-style: disc;
  }

  .more {
    margin: 0;
    padding: 0.35rem;
    border: 0;
    background: none;
    flex-shrink: 0;
    font-family: inherit;
    font-style: italic;
    font-size: 0.78rem;
    color: rgb(var(--color-text-muted));
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .notes {
    margin-top: 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-bottom: 0.45rem;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    padding: 0;
    list-style: none;
  }

  .tech li {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid rgba(var(--color-rule), 0.14);
    border-radius: 999px;
    font-size: 0.75rem;
    color: rgb(var(--color-text-muted));
  }

  .icon {
    width: 0.75rem;
    height: 0.75rem;
  }

  @media (max-width: 640px) {
    .post {
      grid-template-columns: 0.85rem 1fr;
    }
    .when {
      grid-column: 2;
      padding-top: 0;
    }
    .body {
      grid-column: 2;
    }
  }

  @media print {
    .post {
      padding: 0.25rem 0;
      break-inside: avoid;
      grid-template-columns: 6rem 1fr;
    }

    .track {
      display: none;
    }

    .notes {
      display: flex !important;
    }
  }
</style>
