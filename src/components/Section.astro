---
const { className, title } = Astro.props;
---

<section class:list={["leaf", className]}>
  {
    title && (
      <h2>{title}</h2>
    )
  }
  <slot />
</section>

<style>
  .leaf {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  h2 {
    font-style: italic;
    font-weight: 400;
    font-size: 1.35rem;
    letter-spacing: -0.015em;
    color: rgb(var(--color-text-base));
  }

  @media print {
    .leaf {
      gap: 0.4rem;
    }

    h2 {
      font-size: 14pt;
      font-style: normal;
      font-weight: 600;
    }
  }
</style>
