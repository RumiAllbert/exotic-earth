---
import Layout from "@/layouts/Layout.astro";
import { NOT_FOUND_MARKDOWN } from "@/lib/site-content";
import { basics } from "@cv";

const { name } = basics;
---

<Layout title={`Not found · ${name}`} description="This path does not exist on rumicalles.com." noindex>
  <main class="doc">
    <p class="back">
      <a href="/">Home</a>
    </p>
    <article class="doc-page">
      <h1>Not found</h1>
      <p>
        This path does not exist (HTTP 404). Try <code>/llms.txt</code> or
        <code>/sitemap.md</code>.
      </p>
      <h2>Where to look next</h2>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
        <li><a href="/sitemap.md">Sitemap</a></li>
        <li><a href="/sitemap-index.xml">XML sitemap</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <pre class="agent-recovery">{NOT_FOUND_MARKDOWN}</pre>
    </article>
  </main>
</Layout>

<style>
  .doc {
    width: min(42rem, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 3.75rem 0 5.5rem;
  }
  .back {
    margin: 0 0 2rem;
    font-size: 0.95rem;
    color: rgb(var(--color-text-muted));
  }
  h1 {
    font-weight: 500;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    letter-spacing: -0.03em;
    margin-bottom: 1.35rem;
  }
  .doc-page a,
  .back a {
    color: rgb(var(--color-text-base));
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .doc-page h2 {
    font-style: italic;
    font-weight: 400;
    font-size: 1.45rem;
    margin: 2rem 0 0.7rem;
  }
  .doc-page p {
    margin: 0 0 1rem;
  }
  .doc-page ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .doc-page code {
    font-size: 0.9em;
  }
  .agent-recovery {
    margin-top: 2rem;
    padding: 1.1rem 1.2rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.88rem;
    background: rgb(var(--color-button-muted));
  }
</style>
