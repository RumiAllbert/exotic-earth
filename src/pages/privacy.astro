---
import { translator } from "@/i18n";
const t = translator(Astro.url.pathname);
import DocPage from "@/layouts/DocPage.astro";
import { docPages } from "@/lib/site-content";

const page = docPages.privacy;
---

<DocPage title={t(page.title)} description={t(page.description)}>
  {page.sections.map((section) => (
    <section>
      <h2>{t(section.heading)}</h2>
      {section.paragraphs.map((paragraph) => (
        <p>{t(paragraph)}</p>
      ))}
    </section>
  ))}
</DocPage>
