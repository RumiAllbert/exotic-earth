---
import Hero from "@/components/sections/Hero.astro";
import Section from "@/components/Section.astro";
import { projects, publications } from "@cv";
import Layout from "@/layouts/Layout.astro";
import { basics } from "@cv";

const { name, label, email, profiles } = basics;
const selectedProjects = ["Etymon.ai", "Vertor"].map(name => projects.find(project => project.name === name)!);
const selectedPapers = publications.filter(paper => [
  "Evaluating Speech-to-Text x LLM x Text-to-Speech Combinations for AI Interview Systems",
  "PhiloBERTA: A Transformer-Based Cross-Lingual Analysis of Greek and Latin Lexicons",
  "Identifying and Manipulating Personality Traits in LLMs Through Activation Engineering",
].includes(paper.title));
---

<Layout title={`${name} - ${label}`} description={basics.summary}>
  <Hero />

  <main id="main-content" class="codex">
    <section id="work">
      <Section title="Selected work">
        <article class="current-work">
          <p class="eyebrow">micro1 · Director of Research Engineering · 2025–present</p>
          <h3>RL environments and post-training</h3>
          <p>I lead the work from task specifications and rewards through evaluation and policy iteration. My scope includes data, reward models, and standards for environment quality and training stability.</p>
          <a class="text-link" href="/cv">Experience and background ↗</a>
        </article>
        <div class="selected-projects">
          {selectedProjects.map(project => (
            <article>
              <a href={project.url} target="_blank" rel="noopener noreferrer">
                <img src={`/projects/${project.name === "Vertor" ? "vertor" : "etymon"}.webp`} alt={`${project.name} interface`} width="1200" height="630" loading="lazy" />
                <h3>{project.name} ↗</h3>
              </a>
              <p>{project.description}</p>
              <p class="detail">{project.name === "Vertor"
                ? "A sentence-by-sentence workflow for composing, comparing translations, and refining literary register."
                : "Morphological breakdowns and visual graphs connect words to their roots and related forms."}</p>
            </article>
          ))}
        </div>
      </Section>
    </section>
    <section id="research">
      <Section title="Selected research">
        <ol class="research-list">
          {selectedPapers.map(paper => (
            <li>
              <p class="eyebrow">{paper.publisher} · {paper.date.slice(0, 4)} · {paper.type}</p>
              <h3><a href={paper.url} target="_blank" rel="noopener noreferrer">{paper.title} ↗</a></h3>
              <p>{paper.highlight}</p>
            </li>
          ))}
        </ol>
        <a class="text-link" href="/cv#publications">All publications ↗</a>
      </Section>
    </section>
    <section id="about">
      <Section title="Beyond the work">
        <p class="personal">{basics.summary} My classical studies include a master's in humanities at Ralston College and immersion in Latin and Ancient Greek at Academia Vivarium Novum.</p>
        <blockquote>
          <p lang="grc">πάντες ἄνθρωποι τοῦ εἰδέναι ὀρέγονται φύσει.</p>
          <p>All human beings by nature stretch toward knowing.</p>
        </blockquote>
        <p class="languages">English · Español · 中文 · Italiano · Latin · Attic Greek</p>
      </Section>
    </section>
  </main>

  <footer id="contact" class="close no-print">
    <a class="mail" href={`mailto:${email}`}>{email}</a>
    <div class="social">
      {
        profiles.map(({ network, url }) => (
          <a href={url} target="_blank" rel="noopener noreferrer">
            {network}
          </a>
        ))
      }
    </div>
    <nav>
      <a href="/cv">Full CV</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy</a>
      <a href="/llms.txt">llms.txt</a>
    </nav>
    <p class="copy">&copy; {new Date().getFullYear()} {name}</p>
  </footer>
</Layout>

<style>
  .eyebrow { font-size: 0.76rem; letter-spacing: 0.035em; margin: 0 0 0.85rem; }
  h3 { font-size: 1.65rem; line-height: 1.2; }
  .current-work { padding: 1.75rem 0 2rem; border-top: 1px solid rgba(var(--color-rule), 0.2); }
  .current-work p:not(.eyebrow) { max-width: 65ch; }
  .text-link { font-size: 0.85rem; text-decoration: underline; text-underline-offset: 5px; }
  .selected-projects { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .selected-projects img { width: 100%; height: auto; margin-bottom: 1.25rem; border: 1px solid rgba(var(--color-rule), 0.12); }
  .selected-projects p { font-size: 0.93rem; margin: 0.75rem 0; }
  .selected-projects .detail { font-size: 0.85rem; }
  .research-list { list-style: none; padding: 0; margin: 0; }
  .research-list li { padding: 1.5rem 0; border-top: 1px solid rgba(var(--color-rule), 0.16); }
  .research-list h3 { font-size: 1.45rem; max-width: 46ch; }
  .research-list p:last-child { font-size: 0.93rem; margin-bottom: 0; }
  h3 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .personal { max-width: 62ch; margin: 0; }
  blockquote { margin: 0.5rem 0 0; padding-left: 1.5rem; border-left: 1px solid rgba(var(--color-rule), 0.25); }
  blockquote p { margin: 0.3rem 0; font-size: 0.88rem; }
  blockquote p[lang] { font-family: Newsreader, Georgia, serif; font-size: 1.25rem; }
  .languages { font-size: 0.8rem; margin: 0; }
  @media (max-width: 600px) { .selected-projects { grid-template-columns: 1fr; gap: 2rem; } }

  .codex {
    width: min(52rem, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 4.5rem 0 6rem;
    display: grid;
    gap: 4.25rem;
  }

  .codex :global(section) {
    scroll-margin-top: 5rem;
  }

  .close {
    width: min(52rem, calc(100% - 2.5rem));
    margin: 0 auto 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(var(--color-rule), 0.12);
  }

  .mail {
    color: rgb(var(--color-text-base));
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .social,
  .close nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 0.95rem;
    color: rgb(var(--color-text-muted));
  }

  .social a:hover,
  .close nav a:hover {
    color: rgb(var(--color-text-base));
  }

  .copy {
    margin-top: 1.75rem;
    font-size: 0.82rem;
    color: rgb(var(--color-text-muted));
  }

  @media print {
    .codex {
      width: 100%;
      padding: 1rem 0;
      gap: 1.5rem;
    }
  }
</style>
