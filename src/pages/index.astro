---
import Layout from "@/layouts/Layout.astro";
import { basics, projects, publications, work } from "@cv";
const selectedNames = ["Etymon.ai", "Vertor"];
const selected = selectedNames.map(
  (name) => projects.find((project) => project.name === name)!,
);
const remaining = projects.filter(
  (project) => !selectedNames.includes(project.name),
);
const essay = publications[0];
const currentRoles = work.filter((job) => !job.endDate).slice(0, 3);
---

<Layout title={`${basics.name} · Research engineer & classicist`}>
  <main id="main-content" class="page-width">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="small-rule" aria-hidden="true"></span> Research engineer &amp;
          classicist
        </p>
        <h1 id="intro-title">
          Ancient languages.<br />Artificial minds.<br /><em>I work on both.</em>
        </h1>
        <p class="hero-description">
          I'm Rumi Calles. I lead research engineering at micro1, study how
          language models behave, and build tools for people who care about words.
        </p>
        <div class="hero-links">
          <a class="text-link" href="#projects"
            >Explore my work <span aria-hidden="true">↓</span></a
          ><a class="quiet-link" href="#publications"
            >Read my writing <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure class="portrait">
        <div class="portrait-image">
          <img
            src={basics.image}
            alt="Rumi Alexander Elías Calles outdoors"
            width="939"
            height="922"
            fetchpriority="high"
          />
        </div>
        <figcaption>
          <span>Rumi Alexander Elías Calles</span><span
            >{basics.location.city} &amp; elsewhere</span>
        </figcaption>
      </figure>
      <div class="current-line">
        <span class="eyebrow">Currently</span><p>
          Leading research engineering at <a
            href={work[0].url}
            target="_blank"
            rel="noopener noreferrer">micro1 ↗</a
          ><span class="current-divider" aria-hidden="true">/</span> Building <a
            href={work[1].url}
            target="_blank"
            rel="noopener noreferrer">Aeterna Institute ↗</a>
        </p>
      </div>
    </section>

    <div class="evidence-strip" aria-label="Selected research">
      <a href="https://arxiv.org/abs/2507.16835" target="_blank" rel="noopener noreferrer">
        <span class="eyebrow">Voice AI / Coauthored research ↗</span>
        <strong>300,000+</strong>
        <p>Interviews in the source dataset for our study of production voice AI stacks.</p>
      </a>
      <a href="https://arxiv.org/abs/2412.10427" target="_blank" rel="noopener noreferrer">
        <span class="eyebrow">Interpretability / Coauthored research ↗</span>
        <strong>Inside the model.</strong>
        <p>Identifying and steering personality traits through activation engineering.</p>
      </a>
    </div>

    <section id="projects" class="content-section" aria-labelledby="work-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / Built &amp; shipped</p><h2 id="work-title">
            Selected work<span class="accent">.</span>
          </h2>
        </div><a class="quiet-link" href="#project-index"
          >The project index <span aria-hidden="true">↗</span></a>
      </div>
      <details class="word-specimen">
        <summary>
          <span class="eyebrow">Etymon / A word worth opening</span>
          <span class="specimen-word">philosophy<span class="accent">.</span></span>
          <span class="specimen-hint">Open the word <span aria-hidden="true">+</span></span>
        </summary>
        <div class="word-roots">
          <div><span class="eyebrow">Greek / combining form</span><h3 lang="grc">φιλο-</h3><p>loving</p></div>
          <span class="root-plus" aria-hidden="true">+</span>
          <div><span class="eyebrow">Greek / noun</span><h3 lang="grc">σοφία</h3><p>wisdom</p></div>
          <p class="root-note">A love of wisdom. A word can hold an entire way of seeing.<br /><a class="text-link" href={selected[0].url} target="_blank" rel="noopener noreferrer">Explore more words in Etymon ↗</a></p>
        </div>
      </details>
      <div class="featured-projects">
        {
          selected.map((project, index) => (
            <article class="featured-project">
              <a
                class:list={[
                  "project-image",
                  index === 0 ? "etymon-image" : "vertor-image",
                ]}
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Explore ${project.name}`}
              >
                <img
                  src={`/projects/${index === 0 ? "etymon" : "vertor"}.webp`}
                  width={index === 0 ? 955 : 1494}
                  height={index === 0 ? 616 : 609}
                  alt={
                    index === 0
                      ? "Etymon's visual map of philosophy and its Greek roots"
                      : "Vertor's side-by-side literary translation workspace"
                  }
                  loading="lazy"
                />
                <span class="image-link" aria-hidden="true">
                  ↗
                </span>
              </a>
              <div class="project-caption">
                <>
                  <p class="eyebrow">
                    {index === 0
                      ? "Language / Interactive exploration"
                      : "Language / Creative tools"}
                  </p>
                  <h3>
                    <a
                      href={project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {project.name}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </h3>
                  <p>
                    {index === 0
                      ? "Dictionaries give you a definition. I built Etymon to let you follow the roots, history, and relationships behind a word."
                      : "Literary translation needs room for judgment. I built a workspace to compare model translations and refine a passage word by word."}
                  </p>
                </>
              </div>
            </article>
          ))
        }
      </div>
      <a
        class="research-project"
        href={projects.find((project) => project.name === "LLM Abliterator")!
          .github}
        target="_blank"
        rel="noopener noreferrer"
        ><span class="eyebrow">Open-source research</span><h3>
          Inside the model.
        </h3><p>
          Abliterator explores how personality traits can be identified and
          steered through a language model's activations.
        </p><span class="text-link"
          >Explore Abliterator <span aria-hidden="true">↗</span></span
        ></a
      >
      <details id="project-index" class="project-index">
        <summary
          ><span>More projects &amp; experiments</span><span class="eyebrow"
            >{remaining.length} projects <span
              class="disclosure-mark"
              aria-hidden="true">+</span
            ></span
          ></summary
        >
        <div class="index-list">
          {
            remaining.map((project) => (
              <article>
                <h3>
                  <a href={project.url} target="_blank" rel="noopener noreferrer">
                    {project.name} ↗
                  </a>
                </h3>
                <p>{project.description}</p>
                {project.github && (
                  <a
                    class="quiet-link"
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Source code ↗
                  </a>
                )}
              </article>
            ))
          }
        </div>
      </details>
    </section>

    <section
      id="publications"
      class="content-section"
      aria-labelledby="writing-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / Papers &amp; essays</p><h2 id="writing-title">
            Research &amp; writing<span class="accent">.</span>
          </h2>
        </div><span class="section-note"
          >Machine intelligence. Human questions.</span>
      </div>
      <article class="featured-essay">
        <div class="essay-meta">
          <span class="eyebrow">Featured essay</span><time datetime={essay.date}
            >May 2026</time>
        </div>
        <div>
          <h3>
            <a href={essay.url} target="_blank" rel="noopener noreferrer"
              ><em>De Suspensione</em><br />Inflection, composition,<br />and
              the long drift outward.</a>
          </h3><p>
            What happens to thought when we hand over the work of composing it?
            On Latin inflection, digital memory, and generative AI.
          </p><a
            class="text-link"
            href={essay.url}
            target="_blank"
            rel="noopener noreferrer"
            >Read the essay <span aria-hidden="true">↗</span></a>
        </div>
      </article>
      <div class="writing-list">
        {
          publications.slice(1).map((paper, index) => (
            <article>
              <>
                <span class="paper-number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <>
                    <p class="eyebrow">
                      {paper.publisher} / {paper.date.slice(0, 4)}
                    </p>
                    <h3>
                      <a
                        href={paper.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {paper.title}
                      </a>
                    </h3>
                    <p>{paper.highlight}</p>
                  </>
                </div>
                <a
                  class="paper-arrow"
                  href={paper.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Read ${paper.title}`}
                >
                  ↗
                </a>
              </>
            </article>
          ))
        }
      </div>
    </section>

    <section
      id="about"
      class="content-section about-section"
      aria-labelledby="about-title"
    >
      <div>
        <p class="eyebrow">03 / Beyond the code</p><h2 id="about-title">
          About
        </h2>
      </div>
      <div>
        <p class="about-lead">
          Equally at home with a language model and a page of Ancient Greek.
        </p><p>
          I lead research engineering for RL environments and post-training. I
          also write on philosophy of mind, teach ethics of computing, and
          founded Aeterna Institute, a project in classical liberal arts.
        </p><p>
          My studies have taken me through data science, the humanities, and
          daily life in Latin and Ancient Greek at Academia Vivarium Novum.
          These interests keep finding their way into what I build.
        </p><div class="hero-links">
          <a class="text-link" href="/about">More about me ↗</a><a
            class="quiet-link"
            href="/cv">Full curriculum vitae ↗</a>
        </div>
        <div id="experience" class="current-roles">
          <p class="eyebrow">Current affiliations</p>{
            currentRoles.map((job) => (
              <div>
                <>
                  <a href={job.url} target="_blank" rel="noopener noreferrer">
                    {job.name} ↗
                  </a>
                  <span>{job.position}</span>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="contact"
      class="contact-section"
      aria-labelledby="contact-title"
    >
      <p class="eyebrow">Good conversations start somewhere.</p><h2
        id="contact-title"
      >
        What's on <em>your mind?</em>
      </h2><a class="contact-email" href={`mailto:${basics.email}`}
        >{basics.email} <span aria-hidden="true">↗</span></a
      ><p>Research, something you're building, or a thought worth sharing.</p>
    </section>
  </main>
</Layout>

<script>
  const projectIndex = document.querySelector<HTMLDetailsElement>("#project-index");
  document.querySelector('a[href="#project-index"]')?.addEventListener("click", () => {
    if (projectIndex) projectIndex.open = true;
  });
</script>
