---
import About from "@/components/sections/About.astro";
import Education from "@/components/sections/Education.astro";
import Experience from "@/components/sections/Experience.astro";
import SectionProgress from "@/components/SectionProgress.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Publications from "@/components/sections/Publications.astro";
import Skills from "@/components/sections/Skills.astro";
import Layout from "@/layouts/Layout.astro";
import { basics } from "@cv";

const { name, label, email, profiles } = basics;
---

<Layout title={`${name} - ${label}`} description={basics.summary}>
  <Hero />
  <SectionProgress />

  <main id="main-content" class="codex">
    <section id="about">
      <About />
    </section>
    <section id="experience">
      <Experience />
    </section>
    <section id="publications">
      <Publications />
    </section>
    <section id="skills">
      <Skills className="print:hidden" />
    </section>
    <section id="education">
      <Education />
    </section>
    <section id="projects">
      <Projects />
    </section>
  </main>

  <footer id="contact" class="close no-print">
    <a class="mail" href={`mailto:${email}`}>let's chat :)</a>
    <div class="social">
      {
        profiles.map(({ network, url }) => (
          <a href={url} target="_blank" rel="noopener noreferrer">
            {network}
          </a>
        ))
      }
    </div>
    <nav>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy</a>
      <a href="/llms.txt">llms.txt</a>
    </nav>
    <p class="copy">&copy; {new Date().getFullYear()} {name}</p>
  </footer>
</Layout>

<style>
  .codex {
    width: min(52rem, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 4.5rem 0 6rem;
    display: grid;
    gap: 4.25rem;
  }

  .codex :global(section) {
    scroll-margin-top: 5rem;
  }

  .close {
    width: min(52rem, calc(100% - 2.5rem));
    margin: 0 auto 4rem;
    padding-top: 0;
  }

  .mail {
    display: block;
    text-align: center;
    padding: 4rem 0;
    font-size: 1.5rem;
    font-style: italic;
    color: rgb(var(--color-text-base));
    text-decoration: underline;
    text-underline-offset: 7px;
    text-decoration-thickness: 1px;
  }

  .social,
  .close nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 0.95rem;
    color: rgb(var(--color-text-muted));
  }

  .social a:hover,
  .close nav a:hover {
    color: rgb(var(--color-text-base));
  }

  .copy {
    text-align: center;
    margin-top: 1.75rem;
    font-size: 0.82rem;
    color: rgb(var(--color-text-muted));
  }

  @media print {
    .codex {
      width: 100%;
      padding: 1rem 0;
      gap: 1.5rem;
    }
  }
</style>
