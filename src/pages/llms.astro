---
import Layout from '@/layouts/Layout.astro';
import TextLinks from '@/components/TextLinks.astro';
import { llmsText } from '@/lib/llms';
const lines = llmsText.trim().split('\n').filter(Boolean);
---
<Layout title="llms.txt · Rumi Calles" localized={false}>
  <main>
    <p><a href="/">Home</a> · <a href="/llms.txt" download>llms.txt ↓</a></p>
    {lines.map(line => {
      const link = line.match(/^- \[([^\]]+)\]\(([^)]+)\)(.*)$/);
      if (line.startsWith('# ')) return <h1>{line.slice(2)}</h1>;
      if (line.startsWith('## ')) return <h2>{line.slice(3)}</h2>;
      if (link) return <p><a href={link[2]}>{link[1]}</a>{link[3]}</p>;
      return <p><TextLinks text={line.replace(/^> /, '').replaceAll('`', '')} /></p>;
    })}
  </main>
</Layout>
<style>
  main { width: min(42rem, calc(100% - 2.5rem)); margin: 0 auto; padding: 3.75rem 0 5.5rem; }
  h1 { font-size: clamp(2.4rem, 6vw, 3.6rem); line-height: 1.1; margin: 1.5rem 0; }
  h2 { font-size: 1.45rem; font-style: italic; margin-top: 2rem; }
  main :global(a) { text-decoration: underline; text-underline-offset: 3px; }
</style>
