---
import DocPage from "@/layouts/DocPage.astro";
import { docPages } from "@/lib/site-content";

const page = docPages.contact;
---

<DocPage title={page.title} description={page.description}>
  {page.sections.map((section) => (
    <section>
      <h2>{section.heading}</h2>
      {section.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </section>
  ))}
</DocPage>
